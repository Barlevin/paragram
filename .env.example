# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# Every variable without the NEXT_PUBLIC_ prefix is server-only and is
# validated at startup by src/lib/env.server.ts — a missing one fails the
# build rather than failing silently in production.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudflare Turnstile. The site key is designed to be public.
# Test keys that always pass: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Resend — transactional email for lead delivery.
RESEND_API_KEY=""
# The verified sending address on your domain, e.g. "לידים מהאתר <leads@example.co.il>"
LEAD_FROM_EMAIL=""
# Where leads are delivered.
LEAD_TO_EMAIL=""

# Upstash Redis — serverless-correct rate limiting.
# Leave both empty in development; the limiter degrades to allow-all locally
# and logs a warning instead of crashing.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
