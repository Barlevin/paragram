PORT=8787

# Lead delivery via Resend (https://resend.com/api-keys).
# A "sending access" key is enough — it cannot read or manage your account.
RESEND_API_KEY=re_replace_me

# Where new enquiries are sent.
LEADS_TO=you@example.com

# Until paragram.co.il is verified in Resend, keep the onboarding sender below.
# Resend only delivers from it to your own account email address.
# Once the domain is verified, switch to "Paragram <support@paragram.co.il>".
MAIL_FROM="Paragram Website <onboarding@resend.dev>"

# Every lead is appended here before email is attempted, so none can be lost.
LEADS_FILE=./data/leads.jsonl

# Set only when running behind a proxy, CDN or platform router (Render, Railway,
# Nginx, Cloudflare). The number is how many proxy hops to trust.
# Leaving it unset makes the rate limiter treat all visitors as one IP if proxied.
# TRUST_PROXY=1
